{
  "name": "@dotchat/client",
  "version": "0.2.1",
  "private": true,
  "description": "작업표시줄 위 도트 캐릭터 온라인 채팅",
  "author": "DotChat",
  "main": "dist/main/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.main.json && tsc -p tsconfig.renderer.json",
    "start": "electron .",
    "dev": "npm run build && electron .",
    "dist": "npm run build && electron-builder --win nsis"
  },
  "dependencies": {
    "@dotchat/shared": "*",
    "electron-updater": "^6.3.0",
    "socket.io-client": "^4.8.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "electron": "^37.0.0",
    "electron-builder": "^26.0.0",
    "typescript": "^5.6.0"
  },
  "build": {
    "appId": "com.dotchat.client",
    "productName": "DotChat",
    "electronVersion": "37.10.3",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "src/renderer/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../../assets/pixelheroes",
        "to": "pixelheroes"
      }
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "laferr",
        "repo": "DotChat"
      }
    ],
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "deleteAppDataOnUninstall": false
    }
  }
}
